  function cleanName(s) {
    return String(s == null ? "" : s).replace(/\u00a0/g, " ").replace(/^\s*\d+\s*[\.\)\-–:]*\s*/, "")
      .replace(/(\s+[\d.,\/%]+)+\s*$/, "").replace(/\s+/g, " ").trim();
  }
  function isName(s) {
    if (!s || s.length < 3 || s.length > 60) return false;
    if (!/[A-Za-zА-Яа-яЁёЎўҚқҒғҲҳ]/.test(s)) return false;
    if (s.split(" ").length > 6 || /\d{3,}/.test(s)) return false;
    if (/\b(sinf|ro.?yxat|jurnal|maktab|tuman|jami|bsb|chsb)\b/i.test(s)) return false;
    if (/^(?:\u2116|n|t\/r|\u0442\/\u0440|ism|ismi|fio|familiya|fan|sana|baho|ball|foiz)$/i.test(s) || /^(?:f\.?\s?i\.?\s?sh|\u0444\.?\s?\u0438\.?\s?\u0448|familiya[\s,]+ism|o.?quvchi(?:lar|ning)?(?:\s|$))/i.test(s)) return false;
    return true;
  }
  function decodeXml(x) { return x.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, '"').replace(/&apos;/g, "'").replace(/&amp;/g, "&"); }
  function fromSheet(wb) {
    var ws = wb.Sheets[wb.SheetNames[0]];
    var rows = XLSX.utils.sheet_to_json(ws, { header: 1, raw: false, defval: "" });
    var cols = {};
    rows.forEach(function (r) { r.forEach(function (c, i) { if (isName(cleanName(c))) cols[i] = (cols[i] || 0) + 1; }); });
    var best = -1, bc = 0;
    Object.keys(cols).forEach(function (k) { if (cols[k] > bc) { bc = cols[k]; best = +k; } });
    if (best < 0) return rows.map(function (r) { return r.join(" "); });
    return rows.map(function (r) { return String(r[best] == null ? "" : r[best]); });
  }
  function pdfLines(f) {
    return Promise.all([loadScript(LIB.pdf), loadScript(LIB.pdfw)]).then(function () { return f.arrayBuffer(); }).then(function (buf) {
      var lib = window.pdfjsLib; lib.GlobalWorkerOptions.workerSrc = LIB.pdfw;
      return lib.getDocument({ data: new Uint8Array(buf) }).promise;
    }).then(function (doc) {
      var out = [], chain = Promise.resolve();
      for (var p = 1; p <= doc.numPages; p++) {
        (function (pn) {
          chain = chain.then(function () { return doc.getPage(pn); }).then(function (pg) { return pg.getTextContent(); }).then(function (tc) {
            var rows = [];
            tc.items.forEach(function (it) {
              if (!it.str || !it.str.trim()) return;
              var y = Math.round(it.transform[5]), x = it.transform[4];
              var row = rows.find(function (r) { return Math.abs(r.y - y) <= 3; });
              if (!row) { row = { y: y, items: [] }; rows.push(row); }
              row.items.push({ x: x, s: it.str });
            });
            rows.sort(function (a, b) { return b.y - a.y; });
            rows.forEach(function (r) { r.items.sort(function (a, b) { return a.x - b.x; }); out.push(r.items.map(function (i) { return i.s; }).join(" ")); });
          });
        })(p);
      }
      return chain.then(function () { return out; });
    });
