<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>BSB CHSB Hisoblagich</title>
<meta name="description" content="BSB va CHSB natijalarini hisoblash: ball, foiz va baho avtomatik">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230F5C4D'/%3E%3Ctext x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='Arial' font-weight='700'%3E5%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Onest:wght@400;500;600&display=swap">
<style>
/* Layout: bitta ustunli ish sahifasi. Kirish oynasi markazda, ish sahifasida bo'limlar ketma-ket. */
:root {
  --bg: #F1F4F2;
  --surface: #FFFFFF;
  --head: #E7EDEA;
  --ink: #14211D;
  --muted: #5B6A65;
  --line: #D3DCD8;
  --accent: #0F5C4D;
  --accent-ink: #FFFFFF;
  --bad: #B3261E;
  --g5: #1B7F4B; --g5bg: #DDF3E6;
  --g4: #1E64B0; --g4bg: #DCEAF9;
  --g3: #A06A00; --g3bg: #FBEBC8;
  --g2: #B3261E; --g2bg: #FADCD9;
  --f-display: "Bricolage Grotesque", "Onest", system-ui, sans-serif;
  --f-body: "Onest", system-ui, -apple-system, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0E1614; --surface: #16211E; --head: #1E2D29; --ink: #E5EEEA; --muted: #93A49E;
    --line: #2B3A36; --accent: #5FD0B5; --accent-ink: #08201A; --bad: #F2928B;
    --g5: #6FD6A0; --g5bg: #17352A; --g4: #85BBF4; --g4bg: #172B42;
    --g3: #EBC05F; --g3bg: #3A2E12; --g2: #F2928B; --g2bg: #3E1C19;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0E1614; --surface: #16211E; --head: #1E2D29; --ink: #E5EEEA; --muted: #93A49E;
  --line: #2B3A36; --accent: #5FD0B5; --accent-ink: #08201A; --bad: #F2928B;
  --g5: #6FD6A0; --g5bg: #17352A; --g4: #85BBF4; --g4bg: #172B42;
  --g3: #EBC05F; --g3bg: #3A2E12; --g2: #F2928B; --g2bg: #3E1C19;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--ink); font-family: var(--f-body); font-size: 15px; line-height: 1.5;
  padding-block: 20px 56px;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
.wrap { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
h1, h2, h3 { font-family: var(--f-display); margin: 0; text-wrap: balance; }
h1 { font-size: clamp(24px, 6vw, 34px); line-height: 1.1; letter-spacing: -0.01em; }
h2 { font-size: 19px; }
p { margin: 0; }
.eyebrow { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
.muted { color: var(--muted); }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.row { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
.fld { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); font-weight: 500; min-width: 0; }
input[type="text"], input[type="password"], select, textarea {
  font: inherit; font-size: 15px; color: var(--ink); background: var(--bg);
  border: 1px solid var(--line); border-radius: 6px; padding: 9px 10px; min-width: 0; width: 100%;
}
.fld input.s { width: 84px; text-align: center; font-variant-numeric: tabular-nums; }
.sub { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
button, .btn {
  font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; border-radius: 6px; padding: 8px 12px;
  border: 1px solid var(--line); background: var(--surface); color: var(--ink); display: inline-flex; align-items: center; gap: 6px; text-decoration: none;
}
button:hover, .btn:hover { border-color: var(--accent); }
button:disabled { opacity: 0.45; cursor: not-allowed; }
button.primary, .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
button.quiet { color: var(--muted); font-weight: 500; }
button.danger:hover { border-color: var(--bad); color: var(--bad); }
button.del { padding: 4px 8px; color: var(--muted); font-weight: 500; border-color: transparent; background: transparent; }
button.del:hover { color: var(--bad); border-color: var(--bad); }
.vh { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
.btn:focus-visible, :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.note { background: var(--g3bg); color: var(--g3); border-radius: 8px; padding: 10px 12px; font-size: 14px; display: flex; gap: 8px 12px; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.note button { color: var(--ink); }
.info { background: var(--head); border-radius: 8px; padding: 10px 12px; font-size: 14px; }
.err { color: var(--bad); font-size: 14px; }
.ok { color: var(--g5); font-size: 14px; }

/* kirish */
.auth { max-width: 440px; margin: 4vh auto 0; width: 100%; display: flex; flex-direction: column; gap: 16px; }
.tabs { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.tabs button { border: 0; border-radius: 0; background: var(--bg); color: var(--muted); justify-content: center; padding: 10px; }
.tabs button[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); }
form.stack { display: flex; flex-direction: column; gap: 12px; }
.fld.l { font-size: 13px; }
.password-wrap { display: flex; align-items: stretch; gap: 6px; }
.password-wrap input { flex: 1; min-width: 0; }
.password-toggle { flex: 0 0 44px; justify-content: center; padding: 8px; font-size: 0; position: relative; }
.password-toggle svg { width: 21px; height: 21px; display: block; }
.password-toggle .eye-slash { display: none; }
.password-toggle[aria-pressed="true"] .eye-slash { display: block; }

/* yuqori panel */
.topbar { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; }
.brand { font-family: var(--f-display); font-weight: 700; font-size: 18px; }
.who { display: flex; flex-wrap: wrap; gap: 8px 10px; align-items: center; font-size: 14px; }
.tag { font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--head); color: var(--muted); }

/* tuzilma */
.stp { display: inline-flex; align-items: center; gap: 8px; }
.stp b { min-width: 24px; text-align: center; font-family: var(--f-display); font-size: 20px; font-variant-numeric: tabular-nums; }
.stp button { padding: 4px 12px; font-size: 18px; line-height: 1.2; }
.steppers { display: flex; flex-wrap: wrap; gap: 14px 32px; }
.steppers > div { display: flex; flex-direction: column; gap: 6px; }
.th { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; font-size: 14px; margin-top: 8px; }
.th label { display: flex; align-items: center; gap: 6px; }
.th input { width: 64px; text-align: center; padding: 6px; font-variant-numeric: tabular-nums; }

/* import */
.imp { border: 1px dashed var(--accent); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
.imp ol { margin: 0; padding: 0; list-style: none; max-height: 320px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
.imp li { display: flex; gap: 8px; align-items: center; }
.imp li span { width: 28px; text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
.imp li input { padding: 6px 8px; }
.tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.add { display: flex; gap: 8px; flex: 1 1 260px; min-width: 0; }
details summary { cursor: pointer; font-weight: 600; font-size: 14px; }
details textarea { min-height: 100px; margin-top: 8px; }

/* jadval */
.tablewrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
table { border-collapse: separate; border-spacing: 0; width: 100%; font-variant-numeric: tabular-nums; }
.tablewrap table { min-width: 620px; }
th, td { padding: 6px 8px; border-bottom: 1px solid var(--line); text-align: center; white-space: nowrap; }
thead th { background: var(--head); font-weight: 600; font-size: 13px; line-height: 1.25; padding-block: 8px; }
thead th small { display: block; font-weight: 500; color: var(--muted); font-size: 12px; }
tbody tr:last-child td { border-bottom: 0; }
.n { width: 36px; color: var(--muted); }
.nm { text-align: left; position: sticky; left: 0; background: var(--surface); z-index: 1; min-width: 170px; box-shadow: 1px 0 0 var(--line); }
thead .nm { background: var(--head); }
td.nm input { border: 1px solid transparent; background: transparent; padding: 6px; }
td.nm input:hover, input.sc:hover { border-color: var(--accent); }
input.sc { width: 58px; text-align: center; border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 6px; padding: 6px 4px; font: inherit; font-variant-numeric: tabular-nums; }
input.bad { border-color: var(--bad); background: var(--g2bg); color: var(--g2); }
td.tot, td.pct { font-weight: 600; }
td.pct small { display: block; font-weight: 500; font-size: 11px; color: var(--muted); }
.chip { display: inline-block; min-width: 30px; padding: 3px 8px; border-radius: 999px; font-weight: 700; font-family: var(--f-display); }
.chip.g5 { background: var(--g5bg); color: var(--g5); }
.chip.g4 { background: var(--g4bg); color: var(--g4); }
.chip.g3 { background: var(--g3bg); color: var(--g3); }
.chip.g2 { background: var(--g2bg); color: var(--g2); }
.chip.part { opacity: 0.55; }
.chip.on { background: var(--g5bg); color: var(--g5); font-size: 12px; font-family: var(--f-body); }
.chip.wait { background: var(--g3bg); color: var(--g3); font-size: 12px; font-family: var(--f-body); }
.chip.off { background: var(--g2bg); color: var(--g2); font-size: 12px; font-family: var(--f-body); }
.empty { padding: 22px; text-align: center; color: var(--muted); white-space: normal; }
td.act { text-align: right; }
td.act button { padding: 5px 9px; font-size: 13px; }
td.act { display: table-cell; }
.acts { display: inline-flex; gap: 6px; flex-wrap: nowrap; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.stat { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.stat b { font-family: var(--f-display); font-size: 28px; line-height: 1.1; font-variant-numeric: tabular-nums; }
.stat span { font-size: 13px; color: var(--muted); }
.dist { display: flex; height: 14px; border-radius: 7px; overflow: hidden; background: var(--head); }
.dist i { display: block; height: 100%; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend em { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
.msg { min-height: 22px; font-size: 14px; color: var(--accent); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.msg button { padding: 3px 10px; font-size: 13px; }
.foot { font-size: 13px; color: var(--muted); }
@media (prefers-reduced-motion: no-preference) { button, .btn { transition: border-color .15s, background .15s; } }
</style>
</head>
<body>

<main class="wrap" id="app"></main>

<script>
(function () {
  "use strict";
  var K_USERS = "bsbchsb.users.v2", K_SESS = "bsbchsb.session.v2", K_DATA = "bsbchsb.data.v2.";
  var CONTACT = ""; 
  var LIB = {
    zip: "https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js",
    xlsx: "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js",
    pdf: "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js",
    pdfw: "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js",
    jspdf: "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
  };
  var FANLAR = ["Matematika", "Algebra", "Geometriya", "Fizika", "Kimyo", "Biologiya", "Informatika", "Ona tili va adabiyot", "Ingliz tili", "Rus tili", "Tarix", "Geografiya", "Iqtisodiyot", "Huquq", "Texnologiya", "Jismoniy tarbiya", "Tasviriy sanʼat", "Musiqa", "Boshqa"];

  var $ = function (s) { return document.querySelector(s); };
  var app = $("#app");
  var mem = {};
  function lsGet(k, d) {
    try { var v = localStorage.getItem(k); if (v != null) return JSON.parse(v); } catch (e) {}
    return (k in mem) ? JSON.parse(mem[k]) : d;
  }
  function lsSet(k, v) { var s = JSON.stringify(v); mem[k] = s; try { localStorage.setItem(k, s); } catch (e) {} }
  function lsDel(k) { delete mem[k]; try { localStorage.removeItem(k); } catch (e) {} }
  function uid() { return Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-3); }
  function esc(t) { return String(t == null ? "" : t).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
  function num(v) { if (v == null) return null; v = String(v).trim().replace(",", "."); if (v === "") return null; return /^\d+(\.\d+)?$/.test(v) ? parseFloat(v) : NaN; }
  function fmt(n, d) { return Number(Number(n).toFixed(d == null ? 1 : d)).toString().replace(".", ","); }
  function dstr(ts) { var d = new Date(ts); return ("0" + d.getDate()).slice(-2) + "." + ("0" + (d.getMonth() + 1)).slice(-2) + "." + d.getFullYear(); }

  var me = null, T = null, IMP = [], impNote = "", authTab = "login", authMsg = null, lastDel = null, msgTimer;

  function hashPw(pw, salt, strong) {
    if (strong) {
      var enc = new TextEncoder();
      return crypto.subtle.importKey("raw", enc.encode(pw), "PBKDF2", false, ["deriveBits"]).then(function (k) {
        return crypto.subtle.deriveBits({ name: "PBKDF2", salt: enc.encode(salt), iterations: 310000, hash: "SHA-256" }, k, 256);
      }).then(function (buf) { return Array.from(new Uint8Array(buf)).map(function (b) { return ("0" + b.toString(16)).slice(-2); }).join(""); });
    }
    var data = salt + "|" + pw;
    try {
      return crypto.subtle.digest("SHA-256", new TextEncoder().encode(data)).then(function (buf) {
        return Array.from(new Uint8Array(buf)).map(function (b) { return ("0" + b.toString(16)).slice(-2); }).join("");
      });
    } catch (e) {
      var h = 5381; for (var i = 0; i < data.length; i++) h = ((h << 5) + h + data.charCodeAt(i)) | 0;
      return Promise.resolve("x" + (h >>> 0).toString(16));
    }
  }
  function normLogin(v) {
    v = String(v || "").trim();
    if (v.toLowerCase() === "admin") return "admin";
    if (v.indexOf("@") > -1) return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? v.toLowerCase() : null;
    var d = v.replace(/\D/g, "");
    if (d.length === 9) d = "998" + d;
    return /^998\d{9}$/.test(d) ? "+" + d : null;
  }
  function users() { return lsGet(K_USERS, []); }
  function saveUsers(u) { lsSet(K_USERS, u); }
  function curUser() { var id = lsGet(K_SESS, null); if (!id) return null; return users().find(function (u) { return u.id === id; }) || null; }

  function defaultT() {
    var rows = [["Abdullayev Jasur", [9, 8, 17]], ["Karimova Madina", [10, 10, 19]], ["Rahimov Sardor", [6, 7, 12]],
      ["Toshpoʻlatova Nigora", [8, 9, 15]], ["Yoqubov Bekzod", [4, 5, 9]], ["Ergasheva Dilnoza", [7, 6, 13]]];
    return {
      p: { tuman: "", maktab: "", fio: me ? me.name : "", fan: "", sinf: "", chorak: "1" },
      nB: 2, nC: 1, mx: ["10", "10", "20"], th: { 5: 86, 4: 71, 3: 55 }, sample: true,
      st: rows.map(function (r, i) { return { id: i + 1, name: r[0], s: r[1].map(String) }; })
    };
  }
  function loadT() { var t = lsGet(K_DATA + me.id, null) || defaultT(); if (!t.p.fio) t.p.fio = me.name; return t; }
  function saveT() { lsSet(K_DATA + me.id, T); }

  function maxes() { return T.mx.map(function (m) { return num(m) || 0; }); }
  function maxTotal() { return maxes().reduce(function (a, b) { return a + b; }, 0); }
  function lab(i) { return i < T.nB ? "BSB " + (i + 1) : (T.nC > 1 ? "CHSB " + (i - T.nB + 1) : "CHSB"); }
  function cfgErr() {
    if (T.mx.map(num).some(function (m) { return !(m > 0); })) return "Maksimal ball 0 dan katta son boʻlishi kerak.";
    var a = num(T.th[5]), b = num(T.th[4]), c = num(T.th[3]);
    if ([a, b, c].some(function (x) { return x == null || isNaN(x) || x > 100; })) return "Baho chegaralari 0–100 oraligʻida son boʻlishi kerak.";
    if (!(a > b && b > c)) return "Chegaralar tartibi: 5 baho > 4 baho > 3 baho boʻlishi kerak.";
    return "";
  }
  function gradeOf(p) { var e = 1e-9; if (p + e >= num(T.th[5])) return 5; if (p + e >= num(T.th[4])) return 4; if (p + e >= num(T.th[3])) return 3; return 2; }
  function calc(st) {
    var mx = maxes(), sum = 0, filled = 0, nb = 0, bad = [];
    st.s.forEach(function (v, i) {
      var n = num(v);
      if (n == null) { bad.push(false); return; }
      if (isNaN(n) || n > mx[i]) { bad.push(true); nb++; return; }
      bad.push(false); filled++; sum += n;
    });
    var tot = maxTotal(), exact = tot > 0 ? sum / tot * 100 : 0;
    return { sum: sum, pct: Math.round(exact * 100) / 100, filled: filled, blank: st.s.length - filled - nb, bad: bad, hasBad: nb > 0, grade: (!nb && filled && !cfgErr()) ? gradeOf(exact) : null };
  }

  var loaded = {};
  function loadScript(url) {
    if (loaded[url]) return loaded[url];
    loaded[url] = new Promise(function (res, rej) {
      var s = document.createElement("script");
      s.src = url; s.onload = res;
      s.onerror = function () { delete loaded[url]; rej(new Error("Kerakli kutubxona yuklanmadi. Internetni tekshirib qayta urining.")); };
      document.head.appendChild(s);
    });
    return loaded[url];
  }

  function bar() {
    return '<div class="topbar"><div class="brand">BSB · CHSB</div><div class="who"><span>' + esc(me.name) + '</span><span class="tag">' +
      (me.role === "admin" ? "Admin" : "Oʻqituvchi") + '</span><button type="button" class="quiet" data-act="logout">Chiqish</button></div></div>';
  }
  function viewAuth() {
    var m = authMsg ? '<p class="' + (authMsg.t === "ok" ? "ok" : "err") + '" role="alert">' + esc(authMsg.text) + '</p>' : "";
    var login = '<form class="stack" id="fLogin" autocomplete="on">' +
      '<label class="fld l">Email yoki telefon raqam<input type="text" id="lLogin" inputmode="text" autocomplete="username"></label>' +
      '<label class="fld l">Parol<div class="password-wrap"><input type="password" id="lPass" autocomplete="current-password"><button type="button" class="password-toggle" data-act="toggle-pass" data-target="lPass" aria-label="Parolni ko‘rsatish" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="M3 3 21 21"/></svg></button></div></label>' + m +
      '<button type="submit" class="primary" style="justify-content:center">Kirish</button></form>';
    var reg = '<form class="stack" id="fReg" autocomplete="on">' +
      '<label class="fld l">Ism<input type="text" id="rName" autocomplete="name" placeholder="Ism va familiya"></label>' +
