    if (id === "fLogin") {
      var lg = normLogin($("#lLogin").value), pw = $("#lPass").value;
      if (!lg) return setAuth("login", { t: "err", text: "Email yoki telefon raqamni toʻgʻri kiriting." });
      var u = users().find(function (x) { return x.login === lg; });
      if (!u) return setAuth("login", { t: "err", text: "Bunday foydalanuvchi topilmadi." });
      hashPw(pw, u.salt, u.strong).then(function (h) {
        if (h !== u.hash) return setAuth("login", { t: "err", text: "Parol notoʻgʻri." });
        lsSet(K_SESS, u.id); authMsg = null; render();
      });
      return;
    }
    if (id === "fReg") {
      var name = $("#rName").value.trim().replace(/\s+/g, " "), rl = normLogin($("#rLogin").value), p1 = $("#rPass").value, p2 = $("#rPass2").value;
      var bad = function (t) { setAuth("reg", { t: "err", text: t }); };
      if (name.length < 3) return bad("Ismingizni toʻliq kiriting.");
      if (!rl || rl === "admin") return bad("Email yoki telefon raqamni toʻgʻri kiriting. Telefon: +998 90 123 45 67.");
      if (p1.length < 6) return bad("Parol kamida 6 belgidan iborat boʻlsin.");
      if (p1 !== p2) return bad("Parollar bir xil emas.");
      var all = users();
      if (all.some(function (x) { return x.login === rl; })) return bad("Bu email yoki raqam bilan allaqachon roʻyxatdan oʻtilgan.");
      var salt = uid();
      hashPw(p1, salt, true).then(function (h) {
        all.push({ id: uid(), name: name, login: rl, salt: salt, hash: h, role: "teacher", strong: true, status: "pending", created: Date.now() });
        saveUsers(all);
        setAuth("login", { t: "ok", text: "Roʻyxatdan oʻtdingiz. Endi login va parol bilan kiring." });
      });
    }
  });

  var list = users().filter(function (u) { return u.role !== "admin"; });
  list.push({ id: "admin", name: "Administrator", login: "admin", salt: "a4e3d23dd33be2a139c8d586", hash: "62ec4fed385cdaaf51dd6fa2d19db57595b751aeb2bdad355a6074c3b8829ed5", strong: true, role: "admin", status: "active", created: 0 });
  saveUsers(list); render();
})();
</script>

